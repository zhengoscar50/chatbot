POWABASE_BASE_URL=https://your-project-ref.p.powabase.ai
POWABASE_SERVICE_ROLE_KEY=your-service-role-key
POWABASE_AGENT_MODEL=gpt-4o-mini
POWABASE_PROVIDER_NAME=
POWABASE_PROVIDER_KEY=
ADMIN_PASSWORD=
# Required: signing secret for auth JWTs (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
AUTH_JWT_SECRET=change-me-generate-with-secrets-token_urlsafe

# Registration gate. Empty (the default) means open signup, which is right for
# local development. SET THIS on any deployment whose URL you share: a
# forwarded link would otherwise let anyone register and spend your LLM
# credits. Login is never gated, so rotating this can't lock out existing users.
SIGNUP_INVITE_CODE=
